{
  "name": "text-jellyfin",
  "version": "0.8.0",
  "private": true,
  "main": "desktop/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/auroracoding03/Text-Jellyfin.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scan": "tsx scripts/scan.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "build:desktop": "npm run build && npm run prepare:desktop && electron-builder --win nsis --x64 --publish never",
    "build:desktop:publish": "npm run build && npm run prepare:desktop && electron-builder --win nsis --x64 --publish always"
  },
  "engines": {
    "node": ">=22 <26"
  },
  "build": {
    "appId": "com.textjellyfin.app",
    "productName": "Text Jellyfin",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "desktop/**/*",
      "assets/icons/icon.ico",
      ".next/standalone/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "auroracoding03",
        "repo": "Text-Jellyfin",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "better-sqlite3": "^13.0.2",
    "electron-updater": "^6.8.9",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.12.0",
    "marked": "^18.0.9",
    "next": "14.2.35",
    "pdfjs-dist": "^4.10.38",
    "react": "^18",
    "react-dom": "^18",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanitize-html": "^2.13.1",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jszip": "^3.10.1",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
